# Example configuration only. Set your own local password after copying to .env.
# An empty password leaves Neo4j unconfigured; no real credential is supplied.
NEO4J_PASSWORD=
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_DATABASE=neo4j
NEO4J_TIMEOUT_SECONDS=5

# No provider is approved or contacted by default.
MODEL_PROVIDER=disabled
MODEL_BASE_URL=http://127.0.0.1:11434
MODEL_TIMEOUT_SECONDS=120

# Install Ollama natively and pull the models needed for the selected capability.
# For Phase 1B, enable ollama above and uncomment only the embedding model below.
# Generation is optional for retrieval/indexing; Phase 0's model probe needs both.
# MODEL_GENERATION_MODEL=qwen2.5-coder:3b
# MODEL_EMBEDDING_MODEL=nomic-embed-text

# Evidence input budget includes path/owner metadata and the retrieval prefix.
# Whole physical lines must fit; oversized input fails rather than truncating.
RETRIEVAL_CHUNK_BYTES=1536
EMBEDDING_BATCH_SIZE=8
